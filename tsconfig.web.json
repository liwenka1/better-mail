{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/renderer/src/*"] },
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*.ts"],
  "exclude": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"]
}
