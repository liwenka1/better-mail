{
  "name": "better-mail",
  "version": "0.1.0",
  "description": "A local-first, multi-account email client",
  "license": "MIT",
  "author": "文凯",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm check:architecture && pnpm build",
    "rebuild": "electron-builder install-app-deps",
    "notices": "node scripts/notices.mjs",
    "package:dir": "pnpm build && pnpm notices && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "better-sqlite3": "13.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.4",
    "htmlparser2": "10.1.0",
    "image-size": "2.1.0",
    "imapflow": "2.11.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.73.0",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liwenka1/better-mail.git"
  },
  "homepage": "https://github.com/liwenka1/better-mail",
  "bugs": {
    "url": "https://github.com/liwenka1/better-mail/issues"
  }
}
